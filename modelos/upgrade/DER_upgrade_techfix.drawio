"(1,1)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1699.2" y="829.4" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg4_c105" value="(0,N)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2171.9" y="196.0" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg4_c106" value="(0,1)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2251.0" y="834.0" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg4_c107" value="(1,1)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2251.0" y="196.0" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg4_c108" value="(1,1)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="490.9" y="807.4" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg4_c109" value="(0,N)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="362.3" y="219.0" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg4_c110" value="(1,1)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1701.0" y="799.0" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg4_c111" value="(0,N)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1655.0" y="213.0" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg4_c113" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="2500.0" y="2000.0" width="560.0" height="540.0" as="geometry"/></mxCell><mxCell id="pg4_c1" value="TechFix — Banco Upgrade — DER — Catálogo e Compras" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40.0" y="20.0" width="1800.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg4_c2" value="Módulo: categorias (com auto-relacionamento), serviços, peças, histórico de preço, fornecedores e compras. Cinza: Funcionário, Movimento de Estoque e itens de OS." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40.0" y="62.0" width="2000.0" height="24.0" as="geometry"/></mxCell><mxCell id="pg4_c72" value="Legenda" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2514.0" y="2008.0" width="300.0" height="24.0" as="geometry"/></mxCell><mxCell id="pg4_c73" value="Entidade (tabela do banco)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2598.0" y="2042.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg4_c74" value="Atributo (coluna não-FK); sublinhado = identificador (PK)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2598.0" y="2082.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg4_c75" value="Relacionamento (losango); as FKs viram relacionamentos" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2598.0" y="2122.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg4_c76" value="Entidade associativa: tabela de itens que resolve um N:M e tem id próprio (os_servico, os_peca, compra_item)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2598.0" y="2170.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg4_c77" value="Entidade de outro módulo (cinza, sem atributos): mostra só a ligação" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2598.0" y="2222.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg4_c78" value="Atributo derivado/calculado (tracejado): valor_total" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2598.0" y="2262.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg4_c79" value="controle = colunas criado_em, atualizado_em, versao agrupadas" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2598.0" y="2302.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg4_c80" value="(mín,máx) em negrito, leitura cruzada: junto de cada entidade está quantas ocorrências dela se ligam a UMA ocorrência da outra; (0,N) fica junto da entidade do lado &quot;muitos&quot;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2598.0" y="2340.0" width="450.0" height="60.0" as="geometry"/></mxCell><mxCell id="pg4_c81" value="historico_preco é polimórfico (tipo_item + id_item): registra alterações de preço de Serviço e de Peça." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2514.0" y="2402.0" width="532.0" height="64.0" as="geometry"/></mxCell><mxCell id="pg4_c82" value="criado_por/atualizado_por (rastreabilidade) ligam Funcionário a Serviço e Peça: omitidos, ver auditoria." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2514.0" y="2452.0" width="532.0" height="64.0" as="geometry"/></mxCell><mxCell id="pg4_c83" value="Auditoria registra alterações de todas as entidades." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2514.0" y="2502.0" width="532.0" height="64.0" as="geometry"/></mxCell><mxCell id="pg4_c114" value="Entidade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2514.0" y="2040.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg4_c115" value="atributo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2514.0" y="2080.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg4_c116" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2514.0" y="2120.0" width="70.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg4_c117" value="" style="shape=associativeEntity;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="2514.0" y="2168.0" width="70.0" height="44.0" as="geometry"/></mxCell><mxCell id="pg4_c118" value="Outro módulo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#8a8a8a;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2514.0" y="2220.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg4_c119" value="derivado" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="2514.0" y="2260.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg4_c120" value="controle" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeCol