ign=center;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1955.0" y="1181.0" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg7_c67" value="(1,1)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="933.3" y="1781.6" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg7_c68" value="(0,N)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1922.7" y="1200.4" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg7_c69" value="técnico" style="text;html=1;align=center;verticalAlign=middle;fontStyle=2;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="869.5" y="1463.5" width="61.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg7_c70" value="técnico" style="text;html=1;align=center;verticalAlign=middle;fontStyle=2;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="3069.5" y="1463.5" width="61.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg7_c71" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="60.0" y="1950.0" width="560.0" height="430.0" as="geometry"/></mxCell><mxCell id="pg7_c1" value="TechFix — Banco Upgrade — DER — Ordem de Serviço (itens e pagamentos)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40.0" y="20.0" width="1800.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg7_c2" value="Módulo (2/2): itens de serviço e de peça (entidades associativas), formas de pagamento e pagamentos. Atributos da OS: página anterior." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40.0" y="62.0" width="2000.0" height="24.0" as="geometry"/></mxCell><mxCell id="pg7_c42" value="Legenda" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="74.0" y="1958.0" width="300.0" height="24.0" as="geometry"/></mxCell><mxCell id="pg7_c43" value="Entidade (tabela do banco)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="158.0" y="1992.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg7_c44" value="Atributo (coluna não-FK); sublinhado = identificador (PK)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="158.0" y="2032.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg7_c45" value="Relacionamento (losango); as FKs viram relacionamentos" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="158.0" y="2072.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg7_c46" value="Entidade associativa: tabela de itens que resolve um N:M e tem id próprio (os_servico, os_peca, compra_item)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="158.0" y="2120.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg7_c47" value="Entidade de outro módulo (cinza, sem atributos): mostra só a ligação" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="158.0" y="2172.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg7_c48" value="(mín,máx) em negrito, leitura cruzada: junto de cada entidade está quantas ocorrências dela se ligam a UMA ocorrência da outra; (0,N) fica junto da entidade do lado &quot;muitos&quot;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="158.0" y="2210.0" width="450.0" height="60.0" as="geometry"/></mxCell><mxCell id="pg7_c49" value="os_servico e os_peca guardam preço e custo congelados (RN02) e o técnico responsável: entidades associativas ligadas a OS, Serviço/Peça e Funcionário." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="74.0" y="2272.0" width="532.0" height="64.0" as="geometry"/></mxCell><mxCell id="pg7_c50" value="Funcionário aparece duas vezes (cópia à direita) só para evitar linhas longas. Auditoria registra alterações de todas as entidades." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="74.0" y="2322.0" width="532.0" height="64.0" as="geometry"/></mxCell><mxCell id="pg7_c72" value="Entidade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="74.0" y="1990.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg7_c73" value="atributo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="74.0" y="2030.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg7_c74" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="74.0" y="2070.0" width="70.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg7_c75" value="" style="shape=associativeEntity;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="74.0" y="2118.0" width="70.0" height="44.0" as="geometry"/></mxCell><mxCell id="pg7_c76" value="Outro módulo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#8a8a8a;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="74.0" y="2170.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg7_c77" value="(0,N)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="74.0" y="2210.0" width="70.0" height="22.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>