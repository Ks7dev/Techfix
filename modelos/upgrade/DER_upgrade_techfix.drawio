th="560.0" height="410.0" as="geometry"/></mxCell><mxCell id="pg2_c1" value="TechFix — Banco Upgrade — DER — Acesso e Pessoas" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40.0" y="20.0" width="1800.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg2_c2" value="Módulo: cargo, permissão, funcionário e usuário. Em cinza, as entidades de outros módulos às quais o Funcionário se liga." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40.0" y="62.0" width="2000.0" height="24.0" as="geometry"/></mxCell><mxCell id="pg2_c52" value="Legenda" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2064.0" y="1488.0" width="300.0" height="24.0" as="geometry"/></mxCell><mxCell id="pg2_c53" value="Entidade (tabela do banco)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2148.0" y="1522.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg2_c54" value="Atributo (coluna não-FK); sublinhado = identificador (PK)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2148.0" y="1562.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg2_c55" value="Relacionamento (losango); as FKs viram relacionamentos" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2148.0" y="1602.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg2_c56" value="Entidade associativa: tabela de itens que resolve um N:M e tem id próprio (os_servico, os_peca, compra_item)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2148.0" y="1650.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg2_c57" value="Entidade de outro módulo (cinza, sem atributos): mostra só a ligação" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2148.0" y="1702.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg2_c58" value="(mín,máx) em negrito, leitura cruzada: junto de cada entidade está quantas ocorrências dela se ligam a UMA ocorrência da outra; (0,N) fica junto da entidade do lado &quot;muitos&quot;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2148.0" y="1740.0" width="450.0" height="60.0" as="geometry"/></mxCell><mxCell id="pg2_c59" value="criado_por/atualizado_por (rastreabilidade) ligam Funcionário a Cliente, Contato, Endereço, Equipamento, Serviço, Peça e OS: omitidos aqui, ver auditoria." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2064.0" y="1802.0" width="532.0" height="64.0" as="geometry"/></mxCell><mxCell id="pg2_c60" value="Auditoria registra alterações de todas as entidades." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2064.0" y="1852.0" width="532.0" height="64.0" as="geometry"/></mxCell><mxCell id="pg2_c95" value="Entidade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2064.0" y="1520.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg2_c96" value="atributo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2064.0" y="1560.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg2_c97" value="" style="rhombus;whiteSpace=wrap;html=1;fillCol