dth="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg6_c95" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="3000.0" y="1550.0" width="560.0" height="448.0" as="geometry"/></mxCell><mxCell id="pg6_c1" value="TechFix — Banco Upgrade — DER — Ordem de Serviço" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40.0" y="20.0" width="1800.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg6_c2" value="Módulo (1/2): ordem de serviço, status e transições, histórico de status e orçamento. Itens, formas de pagamento e pagamentos: página seguinte. Em cinza, outros módulos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40.0" y="62.0" width="2000.0" height="24.0" as="geometry"/></mxCell><mxCell id="pg6_c61" value="Legenda" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="3014.0" y="1558.0" width="300.0" height="24.0" as="geometry"/></mxCell><mxCell id="pg6_c62" value="Entidade (tabela do banco)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3098.0" y="1592.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg6_c63" value="Atributo (coluna não-FK); sublinhado = identificador (PK)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3098.0" y="1632.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg6_c64" value="Relacionamento (losango); as FKs viram relacionamentos" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3098.0" y="1672.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg6_c65" value="Entidade de outro módulo (cinza, sem atributos): mostra só a ligação" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3098.0" y="1720.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg6_c66" value="Atributo derivado/calculado (tracejado): valor_total" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3098.0" y="1760.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg6_c67" value="(mín,máx) em negrito, leitura cruzada: junto de cada entidade está quantas ocorrências dela se ligam a UMA ocorrência da outra; (0,N) fica junto da entidade do lado &quot;muitos&quot;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3098.0" y="1798.0" width="450.0" height="60.0" as="geometry"/></mxCell><mxCell id="pg6_c68" value="status_transicao é um auto-relacionamento N:M de Status da OS (origem -&gt; destino): define o fluxo permitido." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3014.0" y="1860.0" width="532.0" height="64.0" as="geometry"/></mxCell><mxCell id="pg6_c69" value="valor_total = subtotal_servicos + subtotal_pecas - desconto (coluna gerada, tracejada)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3014.0" y="1910.0" width="532.0" height="64.0" as="geometry"/></mxCell><mxCell id="pg6_c70" value="Itens da OS, forma de pagamento e pagamento: ver a página 7. Auditoria registra alterações de todas as entidades." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3014.0" y="1940.0" width="532.0" height="64.0" as="geometry"/></mxCell><mxCell id="pg6_c96" value="Entidade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3014.0" y="1590.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg6_c97" value="atributo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="3014.0" y="1630.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg6_c98" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3014.0" y="1670.0" width="70.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg6_c99" value="Outro módulo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#8a8a8a;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3014.0" y="1718.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg6_c100" value="derivado" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="3014.0" y="1758.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg6_c101" value="(0,N)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="3014.0" y="1798.0" width="70.0" height="22.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg7" name="Ordem de Serviço — itens e pagamentos"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4000" pageHeight="2600" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pg7_c3" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="pg7_os" target="pg7_oserv"><mxGeometry relative="1" as="