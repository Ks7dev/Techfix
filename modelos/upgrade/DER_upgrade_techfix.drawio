="24.0" as="geometry"/></mxCell><mxCell id="pg3_c60" value="Entidade (tabela do banco)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1698.0" y="1722.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg3_c61" value="Atributo (coluna não-FK); sublinhado = identificador (PK)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1698.0" y="1762.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg3_c62" value="Relacionamento (losango); as FKs viram relacionamentos" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1698.0" y="1802.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg3_c63" value="Entidade associativa: tabela de itens que resolve um N:M e tem id próprio (os_servico, os_peca, compra_item)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1698.0" y="1850.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg3_c64" value="Entidade de outro módulo (cinza, sem atributos): mostra só a ligação" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1698.0" y="1902.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg3_c65" value="controle = colunas criado_em, atualizado_em, versao agrupadas" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1698.0" y="1942.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg3_c66" value="(mín,máx) em negrito, leitura cruzada: junto de cada entidade está quantas ocorrências dela se ligam a UMA ocorrência da outra; (0,N) fica junto da entidade do lado &quot;muitos&quot;." style="text;