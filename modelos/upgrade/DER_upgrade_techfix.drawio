rap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2998.0" y="1692.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg5_c39" value="Atributo (coluna não-FK); sublinhado = identificador (PK)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2998.0" y="1732.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg5_c40" value="Relacionamento (losango); as FKs viram relacionamentos" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2998.0" y="1772.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg5_c41" value="Entidade associativa: tabela de itens que resolve um N:M e tem id próprio (os_servico, os_peca, compra_item)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2998.0" y="1820.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg5_c42" value="Entidade de outro módulo (cinza, sem atributos): mostra só a ligação" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2998.0" y="1872.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg5_c43" value="(mín,máx) em negrito, leitura cruzada: junto de cada entidade está quantas ocorrências dela se ligam a UMA ocorrência da outra; (0,N) fica junto da entidade do lado &quot;muitos&quot;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2998.0" y="1910.0" width="450.0" height="60.0" as="geometry"/></mxCell><mxCell id="pg5_c44" value="Regra: ENTRADA &lt;=&gt; origem em Item de Compra; SAIDA_OS e ESTORNO_OS &lt;=&gt; origem em Item de Peça; DESCARTE e AJUSTE_* exigem motivo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2914.0" y="1972.0" width="532.0" height="64.0" as="geometry"/></mxCell><mxCell id="pg5_c45" value="peca.estoque_atual e custo_medio só mudam por movimento (RN03). Auditoria registra alterações de todas as entidades." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2914.0" y="2022.0" width="532.0" height="64.0" as="geometry"/></mxCell><mxCell id="pg5_c64" value="Entidade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2914.0" y="1690.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg5_c65" value="atributo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2914.0" y="1730.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg5_c66" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2914.0" y="1770.0" width="70.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg5_c67" value="" style="shape=associativeEntity;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="2914.0" y="1818.0" width="70.0" height="44.0" as="geometry"/></mxCell><mxCell id="pg5_c68" value="Outro módulo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#8a8a8a;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2914.0" y="1870.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg5_c69" value="(0,N)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2914.0" y="1910.0" width="70.0" height="22.0" as="geometry"/></mxCell></root></m