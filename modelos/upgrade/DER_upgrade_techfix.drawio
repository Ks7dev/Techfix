.0" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg1_c165" value="(0,N)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1455.0" y="486.0" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg1_c166" value="(1,1)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1006.1" y="767.1" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg1_c167" value="(0,N)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1385.7" y="484.4" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg1_c168" value="técnico" style="text;html=1;align=center;verticalAlign=middle;fontStyle=2;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1717.0" y="862.8" width="61.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg1_c169" value="técnico" style="text;html=1;align=center;verticalAlign=middle;fontStyle=2;fontSize=11;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1167.0" y="891.3" width="61.0" height="18.0" as="geometry"/></mxCell><mxCell id="pg1_c175" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="2800.0" y="1450.0" width="560.0" height="450.0" as="geometry"/></mxCell><mxCell id="pg1_c1" value="TechFix — Banco Upgrade — DER — Visão geral" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=26;" vertex="1" parent="1"><mxGeometry x="40.0" y="20.0" width="1800.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg1_c2" value="Conceitual: 27 entidades em 5 módulos (as tabelas de itens aparecem como entidades associativas). Atributos nos DERs por módulo (páginas seguintes)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40.0" y="62.0" width="2000.0" height="24.0" as="geometry"/></mxCell><mxCell id="pg1_c77" value="Legenda" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2814.0" y="1458.0" width="300.0" height="24.0" as="geometry"/></mxCell><mxCell id="pg1_c78" value="Entidade (tabela do banco)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2898.0" y="1492.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg1_c79" value="Atributo (coluna não-FK); sublinhado = identificador (PK)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2898.0" y="1532.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg1_c80" value="Relacionamento (losango); as FKs viram relacionamentos" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2898.0" y="1572.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg1_c81" value="Entidade associativa: tabela de itens que resolve um N:M e tem id próprio (os_servico, os_peca, compra_item)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2898.0" y="1620.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg1_c82" value="Entidade de outro módulo (cinza, sem atributos): mostra só a ligação" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2898.0" y="1672.0" width="450.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg1_c83" value="(mín,máx) em negrito, leitura cruzada: junto de cada entidade está quantas ocorrências dela se ligam a UMA ocorrência da outra; (0,N) fica junto da entidade do lado &quot;muitos&quot;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2898.0" y="1710.0" width="450.0" height="60.0" as="geometry"/></mxCell><mxCell id="pg1_c84" value="Auditoria (log de INSERT/UPDATE/DELETE de todas as entidades) e schema_versao (controle de migrações) são tabelas de metadados: não entram no modelo conceitual." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2814.0" y="1772.0" width="532.0" height="64.0" as="geometry"/></mxCell><mxCell id="pg1_c85" value="Para legibilidade, estes vínculos de Funcionário (1,1) -&gt; (0,N) &quot;registra&quot; só aparecem nas páginas dos módulos: Compra, Movimento de Estoque, Histórico de Preço (e criado_por/atualizado_por em Cliente, Contato, Endereço, Equipamento, Serviço, Peça, OS)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2814.0" y="1822.0" width="532.0" height="64.0" as="geometry"/></mxCell><mxCell id="pg1_c176" value="Entidade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2814.0" y="1490.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg1_c177" value="atributo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2814.0" y="1530.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg1_c178" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2814.0" y="1570.0" width="70.0" height="40.0" as="geometry"/></mxCell><mxCell id="pg1_c179" value="" style="shape=associativeEntity;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="2814.0" y="1618.0" width="70.0" height="44.0" as="geometry"/></mxCell><mxCell id="pg1_c180" value="Outro módulo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#8a8a8a;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2814.0" y="1670.0" width="70.0" height="26.0" as="geometry"/></mxCell><mxCell id="pg1_c181" value="(0,N)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2814.0" y="1710.0" width="70.0" height="22.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg2" name="Acesso e Pessoas"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="2100" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pg2_c93" value="Acesso e Pessoas" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=35;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontStyle=1;fontSize=20;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="15.0" y="177.8" width="2000.8" height="1469.2" as="geometry"/></mxCell><mxCell id="pg2_c3" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="pg2_r_cp" target="pg2_cargo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg2_c4" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="pg2_r_cp" target="pg2_perm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg2_c5" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1" source="pg2_r_cf" target="pg2_cargo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pg2_c6" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=1.5;" edge="