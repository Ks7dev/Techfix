6"/><mxPoint x="2000" y="372"/><mxPoint x="1340" y="372"/></Array></mxGeometry></mxCell><mxCell id="e32" value="(id, id_cargo)" style="rounded=0;html=1;fontSize=9;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#999999;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5400;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontColor=#666666;" edge="1" parent="1" source="r_ordem_11" target="t_funcionario"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1512" y="716"/><mxPoint x="1512" y="384"/><mxPoint x="1310" y="384"/></Array></mxGeometry></mxCell><mxCell id="e33" value="(id, id_cargo)" style="rounded=0;html=1;fontSize=9;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#999999;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.4800;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;fontColor=#666666;" edge="1" parent="1" source="r_ordem_9" target="t_funcionario"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1500" y="676"/><mxPoint x="1500" y="396"/><mxPoint x="1280" y="396"/></Array></mxGeometry></mxCell><mxCell id="title" value="TechFix — Banco de Entrega — Modelo Lógico (MER)" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="regras" value="&lt;b&gt;Regras (triggers)&lt;/b&gt;&lt;br&gt;• Estoque automático: entrada_peca soma; uso em OS (ordem_peca) e descarte (saida_peca) subtraem; estoque ≥ 0 (RN03)&lt;br&gt;• RN01: peça só em OS “Orçamento Aprovado” ou “Em Reparo”&lt;br&gt;• RN04: valor_total recalculado (serviços + peças); “Entregue” exige forma de pagamento&lt;br&gt;• Histórico (ordem_situacao) automático; situação atual e data_fechamento mantidas por trigger&lt;br&gt;• OS encerrada (Entregue/Cancelado) é imutável&lt;br&gt;• RN02: itens da OS, entradas, descartes e histórico imutáveis (sem UPDATE/DELETE)&lt;br&gt;• Técnico da peça = técnico da OS" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="880" width="410" height="200" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;PK = chave primária (negrito)  FK = chave estrangeira&lt;br&gt;NN = NOT NULL  UQ = UNIQUE  DEF = DEFAULT  CK = CHECK&lt;br&gt;Dinheiro em centavos (INTEGER); todas as tabelas STRICT&lt;br&gt;Pé-de-galinha: lado “muitos” na FK, “um” na PK; círculo = opcional&lt;br&gt;Linhas cinzas = FK de auditoria (→ funcionario); pretas = FK de negócio&lt;br&gt;FK composta: (id_funcionario, id_funcionario_cargo) → funcionario (id, id_cargo), rótulo “(id, id_cargo)”; em ordem e ordem_peca também id_tecnico + id_tecnico_cargo&lt;br&gt;&lt;b&gt;Módulos&lt;/b&gt;:  &lt;font style=&quot;background-color:#dae8fc&quot;&gt;&amp;nbsp;Pessoas&amp;nbsp;&lt;/font&gt; &lt;font style=&quot;background-color:#d5e8d4&quot;&gt;&amp;nbsp;Equipamentos&amp;nbsp;&lt;/font&gt; &lt;font style=&quot;background-color:#ffe6cc&quot;&gt;&amp;nbsp;Ordem&amp;nbsp;&lt;/font&gt; &lt;font style=&quot;background-color:#fff2cc&quot;&gt;&amp;nbsp;Catálogo&amp;nbsp;&lt;/font&gt; &lt;font style=&quot;background-color:#f8cecc&quot;&gt;&amp;nbsp;Estoque&amp;nbsp;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="1110" width="470" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>