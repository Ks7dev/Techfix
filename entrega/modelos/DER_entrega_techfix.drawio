keColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="1850" width="90" height="34" as="geometry"/></mxCell><mxCell id="t236" value="Atributo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="190" y="1856" width="300" height="24" as="geometry"/></mxCell><mxCell id="lg3" value="id" style="ellipse;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="1900" width="90" height="34" as="geometry"/></mxCell><mxCell id="t237" value="Atributo identificador (sublinhado)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="190" y="1906" width="400" height="24" as="geometry"/></mxCell><mxCell id="lg4" value="" style="rhombus;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="1950" width="90" height="44" as="geometry"/></mxCell><mxCell id="t238" value="Relacionamento (atributos ligados ao losango)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="190" y="1960" width="500" height="24" as="geometry"/></mxCell><mxCell id="t239" value="(mín,máx) = cardinalidade com leitura cruzada: o valor junto de uma entidade diz quantas ocorrências dela se associam a UMA ocorrência da outra entidade." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="2010" width="1000" height="40" as="geometry"/></mxCell><mxCell id="t240" value="Nota 1 — Cadastro auditado: a coluna id_funcionario (com cargo validado por FK composta) existe também em Marca, Modelo, Tipo, Categoria, Serviço, Peça, Forma de Pagamento, Entrada de Peça e Saída de Peça; só Cliente e Equipamento foram desenhados para não poluir o diagrama (as demais são análogas: Funcionário cadastra ... (0,N) / (1,1))." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="2055" width="1010" height="60" as="geometry"/></mxCell><mxCell id="t241" value='Nota 2 — O relacionamento "passa por" (Ordem × Situação, N:M com atributo data_situacao) corresponde à tabela ordem_situacao (histórico); "está em" é a situação atual (ordem.id_situacao). "contém" = tabela ordem_servico; "utiliza" = tabela ordem_peca.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="2120" width="1010" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>